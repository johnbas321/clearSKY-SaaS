<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My courses</title>

    <%- include('bootstrap-resources') -%>
  </head>

  <body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <%- include('color-modes') -%> <%- include('header', {user: user}) -%>

    <main>
      <div class="table-wrapper container">
        <h4 class="my-4">My courses</h4>
        <div class="table-responsive">
          <table
            class="table table-bordered table-striped align-middle"
            id="requestTable"
          >
            <thead class="table-dark">
              <tr>
                <th>Course Name</th>
                <th>Examination Period</th>
                <th>Grading Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% Object.values(courses).forEach((course) => { %>
              <tr>
                <td><%=course["course_name"]%></td>
                <td><%=course["time_period"]%></td>
                <td><%=course["grade_state"]%></td>
                <td>
                  <button
                    class="btn btn-outline-primary btn-sm review-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#gradesModal"
                    course-id="<%=course["id"]%>"
                    period="<%=course["time_period"]%>"
                    name="<%=course["course_name"]%>"
                    >
                    View my grades
                  </button>
                  <button
                    class="btn btn-outline-primary btn-sm review-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#newReviewModal"
                    course-id="<%=course["id"]%>"
                    period="<%=course["time_period"]%>"
                    name="<%=course["course_name"]%>"
                    state="<%=course["grade_state"]%>"
                    instructor-id="<%=course["instructor_id"]%>"
                    >
                    Ask for review
                  </button>
                  <button
                    class="btn btn-outline-primary btn-sm review-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#statusModal"
                    course-id="<%=course["course_id"]%>"
                    course="<%=course["course_name"]%>"
                    period="<%=course["time_period"]%>"
                    >
                    View review status
                  </button>
                  <button
                    class="btn btn-outline-primary btn-sm review-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#graphModal"
                    course-id="<%=course["course_id"]%>"
                    course="<%=course["course_name"]%>"
                    period="<%=course["time_period"]%>"
                    >
                    View course stats
                  </button>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <div class="modal fade" id="gradesModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="gradesModalTitle">
            </h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div id="gradesModalBody" class="modal-body">
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="newReviewModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="newReviewModalTitle">
            </h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <h2 id="modalPop" class="fs-5"></h2>
            <form id="reviewForm" method="POST" action="/student/review-request">
              <input type="hidden" name="course_name" id="course-name" />
              <input type="hidden" name="time_period" id="period" />
              <input type="hidden" name="grade_state" id="state" />
              <input type="hidden" name="instructor_id" id="instructor_id" />
              <div class="mb-3">
                <label class="form-label">Message for the instructor</label>
                <textarea
                  name="request_message"
                  class="form-control"
                  rows="3"
                ></textarea>
              </div>
              <button type="submit" class="btn btn-success">
                Submit grade review request
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <%- include('footer') -%>

    <script src="courses.js"></script>
  </body>
</html>
