<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="row">
  <% Object.entries(distributions).forEach(([key, dist], index) => { %>
    <div class="col-md-6 mb-4">
      <h5 class="text-center"><%= key === 'total' ? 'Total Distribution' : key %></h5>
      <div style="height: 300px;">
        <canvas
          id="chart-<%= index %>"
          class="grade-chart"
          data-chart='<%= JSON.stringify(dist) %>'
          data-label="<%= key %>">
        </canvas>
      </div>
    </div>
  <% }); %>
</div>