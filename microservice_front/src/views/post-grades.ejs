<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Grades Submission</title>

    <%- include('bootstrap-resources') -%>
  </head>

  <body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <%- include('color-modes') -%> <%- include('header', {user: user}) -%>

    <main
      style="
        max-width: 500px;
        padding: 1rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
      "
    >
      <div class="py-5 text-center">
        <h1 class="h2">Upload <%= grades %> grades</h1>
      </div>
      <div class="row g-5">
        <form id="gradesSubmitForm" enctype="multipart/form-data">
          <div class="row g-3">
            <div class="col-12">
              <div class="mb-3">
                <label for="formFile" class="form-label"
                  >Xlsx file with <%= grades %> grades</label
                >
                <input class="form-control" type="file" id="file" required />
              </div>
            </div>
          </div>
          <hr class="my-4" />
          <div class="row g-3">
            <button class="w-100 btn btn-primary btn-lg" type="submit">
              Submit
            </button>
          </div>
        </form>
      </div>
    </main>

    <div class="modal fade" id="parsingModal" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Xslx file parsing results</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div id="parsingModalBody" class="modal-body"></div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button id="confirmBtn" type="button" class="btn btn-primary">
              Confirm
            </button>
          </div>
        </div>
      </div>
    </div>

    <%- include('footer') -%>

    <script>
      window.state = "<%= grades %>";
    </script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script src="post-grades.js"></script>
  </body>
</html>
