<header>
  <div class="px-3 py-2 text-bg-dark border-bottom">
    <div class="container">
      <div
        class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start"
      >
        <a
          href="/"
          class="d-flex align-items-center my-2 my-lg-0 text-white text-decoration-none"
        >
          <i
            class="bi me-2 bi-mortarboard"
            style="font-size: 3rem; color: #ff5733"
          ></i>
          <span class="fs-4">clearSKY</span>
        </a>
        <ul
          class="nav col-12 col-lg-auto my-2 mx-auto justify-content-center my-md-0 text-small"
        >
          <% if (user) { %>
          <li class="text-center">
            <a href="/gradestatistics" class="nav-link text-white">
              <i
                class="bi d-block mx-auto mb-1 bi-bar-chart"
                style="font-size: 1.5rem"
              ></i>
              Grade Stats
            </a>
          </li>
          <% } %> <% if (user.role === "instructor") { %>
          <li class="text-center">
            <a href="/instructor/upload-init" class="nav-link text-white">
              <i
                class="bi d-block mx-auto mb-1 bi-upload"
                style="font-size: 1.5rem"
              ></i>
              Upload Initial Grades
            </a>
          </li>

          <li class="text-center">
            <a href="/instructor/upload-final" class="nav-link text-white">
              <i
                class="bi d-block mx-auto mb-1 bi-upload"
                style="font-size: 1.5rem"
              ></i>
              Upload Final Grades
            </a>
          </li>
          <% } %> <% if (user.role === "institution_admin") { %>
          <li class="text-center">
            <a href="/admin/usermanagement" class="nav-link text-white">
              <i
                class="bi d-block mx-auto mb-1 bi-people"
                style="font-size: 1.5rem"
              ></i>
              User Management
            </a>
          </li>
          <% } %> <% if (user.role === "student") { %>
          <li class="text-center">
            <a href="/student/courses" class="nav-link text-white">
              <i
                class="bi d-block mx-auto mb-1 bi-emoji-expressionless-fill"
                style="font-size: 1.5rem"
              ></i>
              My courses
            </a>
          </li>
          <% } %>
        </ul>

        <% if (user) { %>
        <div class="d-flex align-items-center">
          <span class="text-white me-3"><%= user.name %></span>
          <div class="flex-shrink-0 dropdown">
            <a
              href="#"
              class="d-block link-body-emphasis text-decoration-none dropdown-toggle"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              style="color: #fff !important"
            >
              <i class="bi bi-person-circle" style="font-size: 1.5rem"></i>
            </a>
            <ul class="dropdown-menu text-small shadow">
              <li><a class="dropdown-item" href="#">Profile</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item" href="/logout">Sign out</a></li>
            </ul>
          </div>
        </div>
        <% } else { %>
        <div class="d-flex align-items-center">
          <a href="/login" class="btn btn-outline-primary me-2">Login</a>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</header>
