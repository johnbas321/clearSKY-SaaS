<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grade Statistics</title>

    <%- include('bootstrap-resources') -%>
  </head>

  <body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <%- include('color-modes') -%> <%- include('header', {user: user}) -%>

    <main class="container">
      <h4 class="my-4">Available Course Statistics</h4>
      <table class="table table-hover" id="statsTable">
        <thead class="table-dark">
          <tr>
            <th>Course Name</th>
            <th>Examination Period</th>
            <th>Initial Grades Submission</th>
            <th>Final Grades Submission</th>
            <th>Statistics</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(function(course) { %>
          <tr data-id="1">
            <td><%= course.course_name %></td>
            <td><%= course.time_period %></td>
            <td>
              <%= course.initial_grades_at ? new
              Date(course.initial_grades_at).toLocaleDateString('en-GB') : "-"
              %>
            </td>
            <td>
              <%= course.final_grades_at ? new
              Date(course.final_grades_at).toLocaleDateString('en-GB') : "-" %>
            </td>
            <td>
              <button
                type="button"
                class="btn btn-info"
                data-bs-toggle="modal"
                data-bs-target="#graphModal"
                course-id="<%= course.id %>"
                course-name="<%= course.course_name %>"
                course-period="<%= course.time_period %>"
                course-final="<%= course.final_grades_at %>"
              >
                Graph
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <div class="modal fade" id="graphModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5">Graph</h1>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
              ></button>
            </div>
            <div class="modal-body">
              <div class="container-fluid" id="graphs"></div>
            </div>
            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
              >
                Close
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('footer') -%>

    <script src="grade-stats.js"></script>
  </body>
</html>
